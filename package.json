{
  "name": "smart-way-logistics",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "install:all": "npm install && npm install --workspace=client && npm install --workspace=server",
    "postinstall": "prisma generate --schema=server/prisma/schema.prisma || true",
    "db:seed": "node server/prisma/seed.js",
    "db:clean": "node server/scripts/clean_db.js"
  },
  "dependencies": {
    "prisma": "^5.14.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
